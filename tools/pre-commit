#!/bin/sh
# Pre-commit guards + cache-buster bump.
# This is the tracked copy; .git/hooks/pre-commit is a shim that execs it.
# Install into a fresh clone with:
#   cp tools/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

changed=$(git diff --cached --name-only)

# When script.js is part of the commit, guard against two classes of bug that
# have bitten this file: a plain syntax error, and two top-level `function name`
# (or `async function name`) declarations in the same scope (they silently
# shadow each other — a duplicate journeySegments once blanked most of the
# page). The `async ` prefix is stripped before comparing, so an async+sync
# pair sharing a name is caught too. Either aborts the commit.
case "$changed" in
  *script.js*)
    if ! node -c script.js; then
      echo "pre-commit: script.js failed its syntax check — commit aborted." >&2
      exit 1
    fi
    dups=$(grep -aoE '^  (async )?function [A-Za-z0-9_]+' script.js | sed 's/async //' | sort | uniq -d)
    if [ -n "$dups" ]; then
      echo "pre-commit: duplicate top-level function(s) in script.js — rename one, they shadow each other:" >&2
      echo "$dups" >&2
      exit 1
    fi
    ;;
esac

# Keep data/schedule.json in step with RUN_PLAN in script.js (agents read it).
# Also regenerate on data/ and routes/ commits: the validator's schedule check
# compares the rule's output for TODAY against disk, so a data-only commit after
# a calendar rollover would otherwise abort until someone regenerated by hand.
# The trigger list has to match the validation case below, or a routes/-only
# commit reaches the validator with a schedule nobody refreshed.
case "$changed" in
  *script.js*|*data/*|*routes/*)
    if node tools/generate-schedule.mjs >/dev/null 2>&1; then
      git add data/schedule.json
      echo "pre-commit: data/schedule.json regenerated"
    else
      echo "pre-commit: schedule generation failed — commit aborted." >&2
      exit 1
    fi
    ;;
esac

# Derived-data integrity (offline, <2 s): variant/branch geometry pairing, GPX
# contract, ROUTES coverage, RUN_PLAN distances, schedule freshness. ok-lines
# are silenced; warnings and failures come through on stderr.
case "$changed" in
  *script.js*|*data/*|*routes/*)
    if node tools/validate-data.mjs >/dev/null; then
      echo "pre-commit: data validation ok"
    else
      echo "pre-commit: data validation failed — commit aborted." >&2
      exit 1
    fi
    ;;
esac

# Tool tests, once a tools/test/ suite exists (activates automatically).
if [ -d tools/test ]; then
  case "$changed" in
    *script.js*|*data/*|*tools/*|*routes/*)
      if ! node --test tools/test/*.test.mjs; then
        echo "pre-commit: tools tests failed — commit aborted." >&2
        exit 1
      fi
      ;;
  esac
fi

# Auto-bump the ?v= cache-buster in index.html whenever files it references change.
# Version = commit count + 100 (monotonic, offset keeps it above the old hand-bumped v78).
# vendor/ and img/ are in the list because three of the five versioned URLs are
# vendored (leaflet.css, leaflet.js, fonts.css) — without it a Leaflet upgrade
# ships under an unchanged URL and every cached client keeps the old copy. sw.js
# is there because the service worker caches everything else.
case "$changed" in
  *script.js*|*style.css*|*index.html*|*data/*|*routes/*|*vendor/*|*img/*|*sw.js*)
    n=$(( $(git rev-list --count HEAD) + 100 ))
    # Not `sed -i`: BSD sed wants `-i ''` and GNU sed reads that as the script,
    # so the one form silently no-ops or corrupts on the other platform. Writing
    # a temp file and moving it over works on both (*.tmp is gitignored).
    if ! sed -E "s/\?v=[0-9]+/?v=$n/g" index.html > index.html.tmp; then
      rm -f index.html.tmp
      echo "pre-commit: cache-buster rewrite failed — commit aborted." >&2
      exit 1
    fi
    mv index.html.tmp index.html
    git add index.html
    echo "pre-commit: cache-buster bumped to ?v=$n"
    ;;
esac
exit 0
